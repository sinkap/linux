# Kernel options required by the multinode test.
# Merge into a base config, e.g.:
#   scripts/kconfig/merge_config.sh -m .config \
#       tools/testing/multinode/multinode.config
#   make ARCH=<arch> olddefconfig
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_EVENTS=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CARVEOUT=y
CONFIG_BLK_DEV_INITRD=y
# BTF is needed for the bpf_mmio kfunc sub-test to resolve kfunc ids;
# DEBUG_INFO_BTF depends on DEBUG_INFO. Without it that sub-test skips.
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
