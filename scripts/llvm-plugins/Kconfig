menuconfig LLVM_PLUGINS
	bool "LLVM plugins"
	depends on CC_IS_CLANG
	depends on $(success,$(LLVM_CONFIG) --version)
	default y
	help
	  LLVM plugins add compiler passes to kernel and module builds.
	  Building them requires matching LLVM development headers and
	  llvm-config.

if LLVM_PLUGINS

config CLANG_PLUGIN_FMODRET_CANDIDATES
	bool "Generate fmod_ret candidate metadata with LLVM"
	depends on DEBUG_INFO_BTF
	default y
	help
	  Emit compiler-derived references to functions which may return errno.
	  The resolve_btfids tool uses this metadata to construct the fmod_ret
	  allow-list.

endif
